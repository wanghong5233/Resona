# ==============================================
# Resona Backend 环境变量配置示例
# 复制此文件为 .env 并填入真实的值
# ==============================================

# ==================== LLM 配置 ====================
# LLM 后端选择: mock | gpt4 | qwen | finetuned
LLM_BACKEND=mock

# OpenAI API 配置（使用 gpt4 时需要）
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ==================== Redis 配置 ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== 应用配置 ====================
# 环境：development | production
ENVIRONMENT=development

# API 配置
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# CORS 允许的源
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

