# ==============================================
# Resona Backend 环境变量配置示例
# 复制此文件为 .env 并填入真实的值
# ==============================================

# ==================== LLM 配置 ====================
# LLM 后端选择: mock | gpt4 | dashscope | qwen | finetuned
LLM_BACKEND=mock

# --- 阿里云通义千问 (DashScope) - 推荐使用 ---
# 成本更低，中文能力更强
DASHSCOPE_API_KEY=REDACTED-DASHSCOPE-KEY
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_NAME=qwen-plus

# --- OpenAI API（备选方案）---
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# --- 豆包 API（备选方案）---
# DOUBAO_API_KEY=
# DOUBAO_BASE_URL=
# DOUBAO_MODEL_NAME=

# --- Kimi/智谱 API（备选方案）---
# KIMI_API_KEY=
# GLM_API_KEY=

# ==================== Redis 配置 ====================
# 'redis' 是 docker-compose.yml 中定义的 Redis 服务名
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== 应用配置 ====================
# 环境：development | production
ENVIRONMENT=development

# API 配置
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# CORS 允许的源
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== 安全配置（为未来预留）====================
# JWT Secret（用户认证，Phase 2+）
# 可通过 `python -c "import secrets; print(secrets.token_hex(32))"` 生成
# SECRET_KEY=REDACTED-SECRET-KEY

# ==================== 数据库配置（为个性化功能预留）====================
# PostgreSQL（MVP 阶段不使用，Phase 5+）
# DATABASE_URL=postgresql+asyncpg://resona:resona_pass@localhost:5432/resona

# ==================== 训练配置（Phase 4）====================
# --- 数据生成配置 ---
# SFT 训练数据大小
TRAINING_DATA_SIZE=5000
# DPO 训练数据大小
TRAINING_DPO_SIZE=2000
# 用于数据生成的 GPT-4 API Key
TRAINING_GPT4_API_KEY=sk-xxx

# --- 云端 GPU 服务器配置 ---
# 训练服务器地址（如 AutoDL / 恒源智慧）
# TRAINING_GPU_SERVER=
# TRAINING_GPU_TYPE=RTX_4090
# TRAINING_SSH_KEY_PATH=~/.ssh/id_rsa

# ==================== 推理服务配置（Phase 3-4）====================
# --- vLLM 服务配置（用于自训练模型）---
# VLLM_BASE_URL=http://localhost:8001
# VLLM_MODEL_PATH=outputs/checkpoints/sft_lora
# VLLM_GPU_MEMORY_UTILIZATION=0.9

# --- Ollama 服务配置（本地部署备选）---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ==================== Prompt 工程配置 ====================
# Prompt 模板版本（用于 A/B 测试）
PROMPT_TEMPLATE_VERSION=v1
# Prompt 缓存 TTL（秒）
PROMPT_CACHE_TTL=3600

# ==================== 风险检测配置 ====================
# 安全关键词库版本
SAFETY_KEYWORDS_VERSION=v1
# 是否启用严格模式（更多关键词检测）
SAFETY_STRICT_MODE=false

# ==================== 监控与日志（为未来预留）====================
# Sentry DSN（错误追踪）
# SENTRY_DSN=
# Logstash Host（日志聚合）
# LOGSTASH_HOST=
# Prometheus Port（指标监控）
# PROMETHEUS_PORT=9090
